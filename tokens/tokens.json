{
  "$description": "Source of truth for habitat design tokens. Every component property must bind to a token here, never to a raw value. tokens.css is generated from this file.",
  "color": {
    "brand": {
      "default": { "value": "#1f6f6b", "description": "Primary brand colour, used for primary actions." },
      "hover":   { "value": "#1a605c", "description": "Primary brand colour on hover." },
      "active":  { "value": "#154f4c", "description": "Primary brand colour when pressed." }
    },
    "surface": {
      "default": { "value": "#ffffff", "description": "Default background surface." },
      "muted":   { "value": "#f4f6f6", "description": "Subtle background for secondary surfaces." }
    },
    "text": {
      "onBrand": { "value": "#ffffff", "description": "Text on top of a brand-coloured surface." },
      "default": { "value": "#16201f", "description": "Default body text." },
      "muted":   { "value": "#5b6b6a", "description": "Secondary, lower-emphasis text." }
    },
    "border": {
      "default": { "value": "#d4dbda", "description": "Default border colour." },
      "strong":  { "value": "#16201f", "description": "High-contrast border, used for secondary buttons." }
    },
    "state": {
      "disabledSurface": { "value": "#e7eaea", "description": "Background of a disabled control." },
      "disabledText":    { "value": "#9aa6a5", "description": "Text of a disabled control." },
      "focusRing":       { "value": "#1f6f6b", "description": "Focus ring colour, must meet 3:1 against adjacent colours." }
    }
  },
  "space": {
    "xs": { "value": "4px" },
    "sm": { "value": "8px" },
    "md": { "value": "12px" },
    "lg": { "value": "16px" },
    "xl": { "value": "24px" }
  },
  "radius": {
    "sm": { "value": "6px" },
    "md": { "value": "10px" }
  },
  "type": {
    "family": { "value": "system-ui, sans-serif", "description": "Body and UI font. Re-theme to your own." },
    "size": {
      "sm": { "value": "14px" },
      "md": { "value": "16px" }
    },
    "weight": {
      "regular": { "value": "400" },
      "medium":  { "value": "550" }
    }
  },
  "motion": {
    "fast": { "value": "120ms", "description": "Duration for state transitions like hover." }
  }
}
